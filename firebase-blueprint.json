{
  "entities": {
    "AdminRole": {
      "title": "AdminRole",
      "description": "Trusted administrator document granting store management privileges.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the administrator.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "role": {
          "type": "string",
          "description": "Administrator role identifier.",
          "enum": ["owner", "admin"],
          "minLength": 4,
          "maxLength": 16
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when admin record was created."
        }
      },
      "required": ["uid", "role", "createdAt"]
    },
    "Product": {
      "title": "Product",
      "description": "Catalog product item published on the open platform by the store or any verified community seller.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique product identifier.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorId": {
          "type": "string",
          "description": "UID of the verified user or administrator who published the product.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Display name of the garment, plush toy, or item.",
          "minLength": 1,
          "maxLength": 160
        },
        "price": {
          "type": "number",
          "description": "Selling price in Cordobas (C$)."
        },
        "originalPrice": {
          "type": "number",
          "description": "Optional original price before discount."
        },
        "category": {
          "type": "string",
          "description": "Product category name.",
          "minLength": 1,
          "maxLength": 80
        },
        "condition": {
          "type": "string",
          "description": "Item condition: nueva or usada.",
          "enum": ["nueva", "usada"],
          "minLength": 5,
          "maxLength": 10
        },
        "description": {
          "type": "string",
          "description": "Product description and details.",
          "minLength": 0,
          "maxLength": 2000
        },
        "primaryImageUrl": {
          "type": "string",
          "description": "Primary product image URL or optimized data URI.",
          "minLength": 1,
          "maxLength": 900000
        },
        "sizesCsv": {
          "type": "string",
          "description": "Comma-separated list of available sizes.",
          "minLength": 1,
          "maxLength": 200
        },
        "colorsCsv": {
          "type": "string",
          "description": "Comma-separated list of available colors.",
          "minLength": 1,
          "maxLength": 200
        },
        "inStock": {
          "type": "boolean",
          "description": "Whether the item is currently in stock."
        },
        "featured": {
          "type": "boolean",
          "description": "Whether the product is highlighted in the catalog."
        },
        "sellerName": {
          "type": "string",
          "description": "Public name of the seller or store on the platform.",
          "minLength": 1,
          "maxLength": 120
        },
        "sellerPhone": {
          "type": "string",
          "description": "Seller WhatsApp contact number for direct orders.",
          "minLength": 1,
          "maxLength": 40
        },
        "sellerCity": {
          "type": "string",
          "description": "Department or city of the seller in Nicaragua.",
          "minLength": 1,
          "maxLength": 80
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update server timestamp."
        }
      },
      "required": [
        "id",
        "authorId",
        "name",
        "price",
        "category",
        "condition",
        "description",
        "primaryImageUrl",
        "sizesCsv",
        "colorsCsv",
        "inStock",
        "featured",
        "createdAt",
        "updatedAt"
      ]
    },
